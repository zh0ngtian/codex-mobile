{
  "id": "codex-mobile-lan-production",
  "repository": "SET_LONG_LIVED_CODEX_MOBILE_REPOSITORY_PATH",
  "remote": "https://github.com/zh0ngtian/codex-mobile.git",
  "branch": "main",
  "target": "vip.loock.codexmobile",
  "environment": "lan-production",
  "lock_scope": "codex-mobile-main-production",
  "adapter": [
    "SET_EXISTING_ABSOLUTE_PYTHON_PATH",
    "{workspace}/scripts/codex_mobile_release_adapter.py"
  ],
  "phases": [
    "main",
    "build",
    "iosbuild",
    "sign",
    "ota",
    "apk",
    "ipa",
    "source",
    "verify"
  ],
  "preflight": [
    "SET_EXISTING_ABSOLUTE_GH_PATH",
    "auth",
    "status"
  ],
  "command_timeout": 7200,
  "required_checks": [
    "adapter-regression",
    "coordinator-recovery",
    "build-contract",
    "typecheck"
  ],
  "options": {
    "kind": "mobile",
    "github_repository": "zh0ngtian/codex-mobile",
    "ios_config": "SET_EXISTING_IOS_CONFIG_PATH",
    "lan_publisher": "SET_EXISTING_LAN_PUBLISHER_PATH",
    "gateway_root": "SET_EXISTING_GATEWAY_ROOT_PATH",
    "gateway_label": "com.minis.codex-mobile-gateway",
    "source_url": "https://signos-source-aggregator.305301890.workers.dev/sources/yao.json",
    "source_credentials": "SET_EXISTING_SOURCE_CREDENTIALS_PATH"
  }
}
